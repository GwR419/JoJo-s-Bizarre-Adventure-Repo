    <text>
        <body>
            <div>
                <pb n="1"/>
                <cbml:panel n="1" characters="#diavolo #gold_experience_requiem">
                    <cbml:balloon n="1" type="speech" who="#diavolo"
                        ><p>BUGAGAOOOOOOOHH!!</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="2" characters="#giorno #gold_experience_requiem">
                    <cbml:balloon n="1" type="speech" who="#giorno #gold_experience_requiem"><p>YOU
                            WILL...</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#giorno #gold_experience_requiem"
                            ><p>NEVER GO...</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#giorno #gold_experience_requiem"
                            ><p>ANY-WHERE...</p></cbml:balloon>
                    <cbml:balloon n="4" type="speech" who="#giorno #gold_experience_requiem"
                            ><p>ESPECIALLY NOT...</p></cbml:balloon>
                    <cbml:balloon n="5" type="speech" who="#giorno #gold_experience_requiem"
                                ><p><emph rendition="b">REALITY</emph>EVER!</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="3" characters="#king_crimson">
                    <cbml:balloon n="1" type="speech" who="#king_crimson #diavolo"><p><emph
                                rendition="b">YOU...</emph></p></cbml:balloon>
                    <cbml:balloon n="1" type="speech" who="#king_crimson #diavolo"><p><emph
                                rendition="b">GODDAMN KID!!</emph></p></cbml:balloon>
                </cbml:panel>
                <pb n="2"/>
                <cbml:panel n="1" characters="#giorno #gold_experience_requiem #diavolo">
                    <cbml:balloon n="1" type="speech" who="#giorno #gold_experience_requiem"
                                ><p><emph rendition="b">MUDAA!!</emph></p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#giorno #gold_experience_requiem"
                                ><p><emph rendition="b">MUDA MUDA MUDA MUDA
                        MUDA</emph></p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="2" characters="#giorno #gold_experience_requiem #diavolo">
                    <cbml:balloon n="1" type="speech" who="#giorno #gold_experience_requiem"
                                ><p><emph rendition="b">MUDAAAAA!!!</emph></p></cbml:balloon>
                </cbml:panel>

                <pb n="3"/>
                <cbml:panel n="1" characters="#diavolo"/>
                <cbml:panel n="2" characters="#diavolo"/>
                <cbml:panel n="3" characters="#diavolo"/>
                <cbml:panel n="4" characters="#diavolo"/>
                <cbml:panel n="5" characters="#diavolo"/>
                <cbml:panel n="6" characters="#diavolo"/>
                <cbml:panel n="7" characters="#giorno #gold_experience_requiem #trish #mista">
                    <cbml:balloon n="1" type="speech" who="#mista"><p>Y...</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#mista"><p>YOU DID IT! AT
                        LAST!</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#giorno"
                        ><p>............</p></cbml:balloon>
                </cbml:panel>
                <pb n="4"/>
                <cbml:panel n="1" characters="#giorno #mista #trish">
                    <cbml:balloon n="1" type="speech" who="#mista"><p>YOUR <emph rendition="b">GOLD
                                EXPERIENCE</emph> EVOLVED THROUGH THE <emph rendition="b"
                                >ARROW</emph>!</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#mista"><p>I DIDN’T REALLY SEE IT OR
                            UNDERSTAND WHAT IT JUST DID, BUT EITHER WAY…!</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#mista"><p>THE BOSS’S <emph rendition="b"
                                >KING CRIMSON</emph> WAS HELPLESS AGAINST IT!</p></cbml:balloon>
                    <cbml:balloon n="4" type="speech" who="#mista"><p>YOU’VE FINALLY DEFEATED
                            HIM!</p></cbml:balloon>
                </cbml:panel>

                <cbml:panel n="2" characters="#mista #trish">
                    <cbml:balloon n="1" type="speech" who="#trish"><p>BUT…</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#trish"><p>WAIT A
                        MINUTE…</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#trish"><p>IS HE FLOATING UP
                            ANYWHERE!?</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="3" characters="#mista #trish">
                    <cbml:balloon n="1" type="speech" who="#trish #mista"
                        ><p>WELL!?</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#trish #mista"
                        ><p>WHERE!?</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#trish #mista"><p>IS HE FLOATING
                        UP?</p></cbml:balloon>
                    <cbml:balloon n="4" type="speech" who="#trish #mista"><p>WHERE IS
                        HE!?</p></cbml:balloon>
                    <cbml:balloon n="5" type="speech" who="#trish #mista"><p>WHERE’S THE
                        CORPSE?</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="4" characters="#giorno #mista #trish">
                    <cbml:balloon n="1" type="speech" who="#giorno"
                        ><p>....................</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="5" characters="#giorno #mista #trish">
                    <cbml:balloon n="1" type="speech" who="#giorno"
                        ><p>....................</p></cbml:balloon>
                </cbml:panel>
                <pb n="5"/>
                <cbml:panel n="1" characters="#trish #mista #giorno #gold_experience_requiem">
                    <cbml:balloon n="1" type="speech" who="#mista"><p><emph rendition="b">WHERE!?
                                FIND HIM, GIORNO</emph></p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#mista"><p><emph rendition="b">WHERE IS
                                HE!?</emph></p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="2" characters="#trish #mista #giorno"/>
                <cbml:panel n="4" characters="#diavolo"/>
                <cbml:panel n="5" characters="#diavolo"/>
                <cbml:panel n="6" characters="#diavolo"/>
                <pb n="6"/>
                <cbml:panel n="1" characters="#diavolo"/>
                <cbml:panel n="2" characters="#diavolo"/>
                <cbml:panel n="3" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>UGH...</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p>UGH...</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="4" characters="#diavolo"/>
                <cbml:panel n="5" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>UAAA
                        AGH...</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p>BARELY...</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#diavolo"><p>STILL...</p></cbml:balloon>
                    <cbml:balloon n="4" type="speech" who="#diavolo"><p>I’M STILL... UGH... GUH...
                            A...</p></cbml:balloon>
                    <cbml:balloon n="5" type="speech" who="#diavolo"><p>UGH...</p></cbml:balloon>
                </cbml:panel>
                <pb n="7"/>
                <cbml:panel n="1" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>ALIVE…
                        SOMEHOW…</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p>BUT… WHAT… WAS
                        THAT…?</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#diavolo"><p>THE <emph rendition="b"
                                >FORECAST</emph>…</p></cbml:balloon>
                    <cbml:balloon n="4" type="speech" who="#diavolo"><p>IT SHOWED… MY CERTAIN…
                            VICTORY…</p></cbml:balloon>
                    <cbml:balloon n="5" type="speech" who="#diavolo"><p>BUT…</p></cbml:balloon>
                    <cbml:balloon n="6" type="speech" who="#diavolo"><p>THAT <emph rendition="b"
                                >REQUIEM</emph>… WHAT DID IT… KUH…</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="2" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>MUST GET IN SEWER… FOR
                            NOW…</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p>FLEE…</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#diavolo"><p>INSIDE…</p></cbml:balloon>
                    <cbml:balloon n="4" type="speech" who="#diavolo"><p>C… CAN MY <emph
                                rendition="b">BODY</emph>… STILL MOVE? IT LEADS… BENEATH
                        ROMA…</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="3" characters="#diavolo"/>
                <cbml:panel n="4" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>G…</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="5" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>GOOD…</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p>I CAN
                        STILL…</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#diavolo"><p>MOVE…</p></cbml:balloon>
                    <cbml:balloon n="4" type="speech" who="#diavolo"><p>D… DID I GET
                        LUCKY!?</p></cbml:balloon>
                    <cbml:balloon n="5" type="speech" who="#diavolo"><p>STILL HAVE THE STRENGTH
                            TO…</p></cbml:balloon>
                    <cbml:balloon n="6" type="speech" who="#diavolo"><p>CLIMB ON…</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="6" characters="#diavolo"/>
                <pb n="8"/>
                <cbml:panel n="1" characters="#diavolo"/>
                <cbml:panel n="2" characters="#diavolo #drug_addict_1 #drug_addict_2">
                    <cbml:balloon n="1" type="speech" who="#drug_addict_1"><p><emph rendition="b"
                                >Y–Y–YOU PUNK!</emph></p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#drug_addict_1"><p><emph rendition="b">Y…
                                YOU TRYIN’ TO CREEP UP ON MY COAT–!</emph></p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#drug_addict_1"><p><emph rendition="b"
                                >AND STEAL IT FROM ME!?</emph></p></cbml:balloon>
                    <cbml:balloon n="4" type="speech" who="#drug_addict_1"><p><emph rendition="b"
                                >UHEHE HE!!</emph></p></cbml:balloon>
                    <cbml:balloon n="5" type="speech" who="#drug_addict_1"><p><emph rendition="b"
                                >YOU WANNA GO!? HUH, BITCH!? HEHEH! COME ON! YOU GONNA GO OR
                                WHAT!?</emph></p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="3" characters="#diavolo #drug_addict_1 #drug_addict_2"/>
                <cbml:panel n="4" characters="#diavolo"/>
                <cbml:panel n="5" characters="#diavolo"/>
                <pb n="9"/>
                <cbml:panel n="1" characters="#diavolo #drug_addict_1 #drug_addict_2">
                    <cbml:balloon n="1" type="speech" who="#drug_addict_1"><p><emph rendition="b"
                                >DON'T FUCK WITH ME!</emph></p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#drug_addict_1"><p><emph rendition="b">I-
                                I- I- UHEHE! I'LL TAKE YOU ON! BRING IT!</emph></p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#drug_addict_1"><p><emph rendition="b"
                                >WELL?</emph></p></cbml:balloon>
                    <cbml:balloon n="4" type="speech" who="#drug_addict_1"><p><emph rendition="b"
                                >HEHE HEHE!</emph></p></cbml:balloon>
                    <cbml:balloon n="5" type="speech" who="#drug_addict_1"><p><emph rendition="b">IF
                                YOU WANT MY COAT, THEN COME AND TAKE IT YOU
                        PRICK!</emph></p></cbml:balloon>
                    <cbml:balloon n="6" type="speech" who="#diavolo"
                        ><p>........................</p></cbml:balloon>

                </cbml:panel>
                <cbml:panel n="2" characters="#drug_addict_1"/>
                <cbml:panel n="3" characters="#drug_addict_1"/>
                <cbml:panel n="4" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>HUH...</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"
                        ><p>............</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="5" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"
                        ><p>..................</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p>UGH...</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="6" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>UGH...</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p>UAGH...</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#diavolo"><p>AGH...
                        AGH...</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="7" characters="#diavolo"/>
                <pb n="10"/>
                <cbml:panel n="1" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p><emph rendition="b"
                                >WHAT...</emph></p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p><emph rendition="b">IN
                                THE-!?</emph></p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="2" characters="#diavolo #drug_addict_1">
                    <cbml:balloon n="1" type="speech" who="#drug_addict_1"><p><emph>COME
                            ON!</emph></p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#drug_addict_1"><p><emph>BRING
                            IT!</emph></p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#diavolo"><p>GACK!</p></cbml:balloon>
                    <cbml:balloon n="4" type="speech" who="#diavolo"><p><emph>THIS
                        IS...</emph></p></cbml:balloon>
                    <cbml:balloon n="5" type="speech" who="#diavolo"><p>WHAT-!?</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="3" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p><emph rendition="b"
                                >IM...</emph></p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p><emph rendition="b"
                                >IMPOS-SIBLE</emph></p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="4" characters="#diavolo #drug_addict_1">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>TH... THIS CAN'T BE! I...
                            CAN'T STAND! UOH... GAAAHG!!</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p>S...
                        SOME-ONE!</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#diavolo"><p>THIS CAN'T BE HAPPENING...
                            N... NOT TO ME!</p></cbml:balloon>
                    <cbml:balloon n="4" type="speech" who="#drug_addict_1"><p><emph>WOOOOOH! I WON'T
                                LET ANYONE TAKE MY COAT!</emph></p></cbml:balloon>
                </cbml:panel>
                <pb n="11"/>
                <cbml:panel n="1" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>THIS PAIN... NOT HERE...!
                            I... I AM DIAVOLO! HOW CAN THIS SCUM...</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p>UUOOOOO OOOHHHH!! I'M
                            BLACKING OUT!</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="2" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>AH!</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="3" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"/>
                </cbml:panel>
                <cbml:panel n="4" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"
                        ><p>............</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="5" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"/>
                </cbml:panel>
                <cbml:panel n="6" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"/>
                </cbml:panel>
                <cbml:panel n="7" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>WHERE AM
                        I?</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"
                        ><p>............</p></cbml:balloon>
                </cbml:panel>
                <pb n="12"/>
                <cbml:panel n="1" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>WHAT?</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p>WHERE IS
                        THIS?</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#diavolo"><p>WHY AM I SLEEPING ON A
                            BED?</p></cbml:balloon>
                    <cbml:balloon n="4" type="speech" who="#diavolo"><p>I REMEMBER FALLING INTO A
                            RIVER AND CLIMBING INTO THE SEWER...</p></cbml:balloon>
                    <cbml:balloon n="5" type="speech" who="#diavolo"><p>DID I PASS
                        OUT?</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="2" characters="#diavolo #female_nurse">
                    <cbml:balloon n="1" type="speech" who="#female_nurse"><p>FILE NO. 68, HEADED BY
                            MYSELF,</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#female_nurse"><p> DOCTOR MONICA
                            ULTERRO.</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#female_nurse"><p>HM, THE DATE IS THE
                            25TH... 11:20 AM,</p></cbml:balloon>
                    <cbml:balloon n="4" type="thought" who="#diavolo"><p>!?</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="3" characters="#diavolo #female_nurse">
                    <cbml:balloon n="1" type="speech" who="#female_nurse"><p>ADULT MALE, ESTIMATED
                            AGE...</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#female_nurse"><p>30-40 YEARS, IDENTITY
                            UNKNOWN.</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="4" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"
                        ><p>..................</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="5" characters="#diavolo #female_nurse">
                    <cbml:balloon n="1" type="speech" who="#female_nurse"><p>NOW PERFORMING THE
                            LEGALLY-MANDATED NECROPSY.</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#female_nurse"><p>JUDGING BY THE
                            CONDITION OF HIS SKIN, HE IS ESTIMATED TO HAVE DIED 48-54 HOURS
                        AGO.</p></cbml:balloon>
                </cbml:panel>
                <cbml:panel n="6" characters="#diavolo"/>
                <cbml:panel n="7" characters="#diavolo">
                    <cbml:balloon n="1" type="speech" who="#diavolo"><p>HEY,
                        WOMAN!</p></cbml:balloon>
                    <cbml:balloon n="2" type="speech" who="#diavolo"><p>W... WHAT DO YOU THINK
                            YOU'RE SAYING!?</p></cbml:balloon>
                    <cbml:balloon n="3" type="speech" who="#diavolo"><p>WHAT IS THIS PLACE? WHY AM I
                            HERE!?</p></cbml:balloon>
                </cbml:panel>
                <pb n="12"/>

            </div>

        </body>
    </text>
</TEI>
